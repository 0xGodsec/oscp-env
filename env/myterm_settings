# Clear ~/Downloads except the top-level VPN configs. -mindepth 1 excludes the
# dir itself (per-user via ~, not a hardcoded /home/kali that could rm -rf the
# wrong dir on a non-kali account); -maxdepth 1 deletes only top-level entries
# so find never errors descending into a dir it just removed. (A VPN config
# nested in a subdir is not preserved - keep HTB.ovpn/THM.ovpn directly in
# ~/Downloads, which is the convention.)
alias cleanDownloads="find ~/Downloads -mindepth 1 -maxdepth 1 -not \( -name HTB.ovpn -or -name THM.ovpn \) -exec rm -rf '{}' +"


