bloodhound-docker() {
    local compose_dir="/opt/myarsenal/bloodhounddocker"
    local compose_file="$compose_dir/docker-compose.yml"
    local remove_volumes=false

    if [[ ! -f "$compose_file" ]]; then
        echo "[!] docker-compose.yml not found in $compose_dir"
        echo "creating compose file in that $compose_dir"
        mkdir -p $compose_dir
        wget -O "$compose_dir/docker-compose.yml" https://raw.githubusercontent.com/SpecterOps/bloodhound/main/examples/docker-compose/docker-compose.yml 
        echo "run again, to start the container"
        return 1
    fi

    case "$1" in
        start)
            if docker-compose -f "$compose_file" ps | grep -q "Up"; then
                echo "[i] BloodHound containers already running."
            else
                echo "[+] Starting BloodHound containers..."
                docker-compose -f "$compose_file" up -d
		docker logs bloodhounddocker-bloodhound-1 | grep "Initial Password Set To"
            fi
            ;;
        stop)
            if docker-compose -f "$compose_file" ps | grep -q "Up"; then
                shift
                if [[ "$1" == "-v" ]]; then
                    remove_volumes=true
                fi

                if [[ "$remove_volumes" == true ]]; then
					echo "[-] Stopping BloodHound and removing volumes..."
					docker-compose -f "$compose_file" down -v
                else
                    echo "[-] Stopping BloodHound containers..."
                    docker-compose -f "$compose_file" down
                fi
            else
                echo "[i] BloodHound containers are not running."
            fi
            ;;
        *)
            echo "Usage: bloodhound-docker {start|stop [-v]}"
            ;;
    esac
}



# Helper script by @sechurity
# Create a log directory, a log file and start logging.
# Guard: only auto-start the logged (script) shell in an INTERACTIVE shell on a
# real TTY. Without the $-/-t checks, `script -f` + `exit` below also fire in
# NON-interactive shells that source this file (scp/sftp/rsync, `bash -c ...`,
# BASH_ENV), where they hang or abort the transfer/command - the classic
# "output/exit in .bashrc breaks scp" footgun. ${UNDER_SCRIPT:-} is nounset-safe.
# The BASH_EXECUTION_STRING check also skips `bash -ic "cmd"` one-shots (which
# are interactive + on a TTY but exist to run cmd, not to open a REPL).
if [ -z "${UNDER_SCRIPT:-}" ] && [[ $- == *i* ]] && [ -z "${BASH_EXECUTION_STRING:-}" ] && [ -t 0 ] && [ -t 1 ]; then
    logdir=${HOME}/logs
    logfile=${logdir}/$(date +%F.%H-%M-%S).$$.log

    mkdir -p ${logdir}
    export UNDER_SCRIPT=${logfile}
    echo "The terminal output is saving to $logfile"
    script -f -q ${logfile}

    exit
fi
